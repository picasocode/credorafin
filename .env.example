# ============================================================================
# CredoraFin — Environment variable template
# Copy to `.env` (local dev) or set as environment variables (prod).
# ============================================================================

# ── Database (Prisma + SQLite) ─────────────────────────────────────────────
# SQLite is a single file on disk — no server, no Docker, no external services.
# The path is relative to the prisma/ directory. The db/ folder is gitignored.
DATABASE_URL="file:./db/app.db"
# Absolute path alternative (useful for systemd / Docker):
# DATABASE_URL="file:/home/ubuntu/credorafin/db/app.db"

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── Admin seed credentials (used by `bun run db:seed`) ─────────────────────
ADMIN_EMAIL="admin@credora.in"
ADMIN_PASSWORD="credora@admin123"
