# ============================================================================
# CredoraFin — Environment variable template
# Copy to `.env` (local dev) or set as environment variables (prod).
# In production, deploy.sh auto-fills the non-secret values below; you only
# need to set SMTP_PASS manually once (see deploy.sh output for instructions).
# ============================================================================

# ── Database (Prisma + SQLite) ─────────────────────────────────────────────
# SQLite is a single file on disk — no server, no Docker, no external services.
# IMPORTANT: use an ABSOLUTE path. Prisma CLI (db push/migrate) resolves relative
# `file:` URLs against the schema.prisma location (prisma/), while the Prisma
# Client at runtime resolves them against cwd — a relative path therefore
# writes the seed to prisma/db/app.db but the app reads ./db/app.db (empty).
# deploy.sh auto-fills this with an absolute path; for local dev, set it below.
# The db/ folder is gitignored.
DATABASE_URL="file:/home/z/my-project/db/app.db"

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV="production"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"
NEXTAUTH_URL="https://credorafin.com"

# ── Admin seed credentials (used by `bun run db:seed`) ─────────────────────
ADMIN_EMAIL="admin@credora.in"
ADMIN_PASSWORD="credora@admin123"

# ── SMTP (Gmail) — for backup emails + lead notifications ──────────────────
# Uses a Gmail App Password (16 chars, no spaces). Generate one at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification ON).
# Leave SMTP_HOST empty to disable email entirely (app stays fully functional;
# sendMail/sendBackupEmail/sendLeadNotification return { ok:false } silently).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="credorafintechpvtltd@gmail.com"
SMTP_PASS=""
SMTP_FROM="CredoraFin <credorafintechpvtltd@gmail.com>"
# Comma-separated recipient lists:
BACKUP_EMAILS="credorafintechpvtltd@gmail.com"
NOTIFY_EMAILS="credorafintechpvtltd@gmail.com"
