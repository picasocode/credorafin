# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# DB backups (created by scripts/backup.ts)
/backups/

# Agent context (per-session notes, not for VCS)
/agent-ctx/

# Runtime PID file (changes every dev server start)
.zscripts/dev.pid

# Supabase local artifacts
/supabase/.branches
/supabase/.temp
/supabase/Branch.dmp

# AWS / Docker build outputs
standalone/
*.tar

# Local SQLite database (binary file, not for VCS — schema managed by Prisma)
/db/

# Tool/cache artifacts
/tool-results/
.tool-results/

# Deploy script runtime
.server.pid

# PM2 logs (production runtime logs, not for VCS)
/logs/

# User-uploaded files (admin upload endpoint writes here at runtime).
# Keep the .gitkeep so the directory exists on fresh deploys, but ignore the
# actual uploaded files — they are runtime data, not source-controlled.
public/uploads/*/
!public/uploads/.gitkeep

